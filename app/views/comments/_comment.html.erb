<% if @article.comments.any? %>
  <table class="table table-dark">
    <thead>
      <tr>
        <th scope="col">Comment Title</th>
        <th scope="col">Comment Body</th>
        <th scope="col">Action</th>
      </tr>
    </thead>
    <tbody>
      <% @article.comments.each do |comment| %>
        <% unless comment.archived? %>
          <tr>
            <th scope="row"><%= comment.title %></th>
            <td><%= comment.body %></td>
            <td>
              <%= link_to 'Delete Comment', [comment.article, comment], data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm' %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted text-center">No comments yet.</p>
<% end %>
